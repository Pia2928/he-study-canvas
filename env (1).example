# Copy these into Render -> Environment. Never commit a real .env.
ANTHROPIC_API_KEY=            # AI co-founder (canvas_ai). Set only in Render.
MODEL=claude-sonnet-5-5
ADMIN_TOKEN=                  # long random string; protects /admin/...
DB_PATH=/var/data/study.db    # on a Render persistent disk
ALLOCATION_SEED=he-canvas-2026   # fix before launch, never change afterwards
CANVAS_SECONDS=1200           # time for the slide in seconds (soft limit: handed in automatically)
ASSIGNED_IDEA=3               # which of the five ideas everyone works on (1-5)
SURVEY_URL=                   # Qualtrics link participants continue to (pid is appended)
FRAME_ANCESTORS='self' https://*.qualtrics.com https://*.prolific.com
ALLOW_FORCED_CONDITION=0      # 1 only for testing (?cond=canvas_ai / canvas_noai)
ALLOW_PREVIEW_PID=0           # 1 only for testing (opens /study without a pid)
